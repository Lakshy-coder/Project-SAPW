# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.

DATABASE_URL="postgresql://sih_user:sih_password@localhost:5432/sih_workbench?schema=public"
PORT=3001
LOG_LEVEL=info
SOVEREIGN_MODE=true

# ─── Ollama (local LLM) ───────────────────────────────────────────────────────
# URL of your running Ollama instance
OLLAMA_BASE_URL=http://localhost:11434
# Model to use — must be pulled first: ollama pull qwen3:4b
OLLAMA_MODEL=qwen3:4b
# Inference timeout in milliseconds (increase for complex engineering prompts)
OLLAMA_TIMEOUT_MS=300000
